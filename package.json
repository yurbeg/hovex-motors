{
  "name": "hovex-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:admin": "node --import tsx --test tests/admin-store.test.ts tests/admin-vehicle-editor.test.ts",
    "test:assistant": "node --import tsx --test tests/assistant-service.test.ts",
    "test:supabase": "node --import tsx --test tests/supabase-vehicles.test.ts",
    "test:admin-repository": "node --import tsx --test tests/admin-vehicle-repository.test.ts",
    "test:admin-image": "node --import tsx --test tests/admin-image-repository.test.ts",
    "test:routes": "node --import tsx --test tests/app-route.test.ts",
    "test:auction-catalog": "node --import tsx --test tests/auction-catalog.test.ts",
    "test:auctionsapi": "node --import tsx --test tests/motorapis-auth.test.ts tests/motorapis-client.test.ts tests/motorapis-mapper.test.ts tests/motorapis-repository.test.ts tests/motorapis-sync.test.ts",
    "test:motorapis": "npm run test:auctionsapi",
    "auctionsapi:trial": "node --import tsx scripts/motorapis-sync.ts --trial",
    "auctionsapi:import": "node --import tsx scripts/motorapis-sync.ts --full",
    "auctionsapi:sync": "node --import tsx scripts/motorapis-sync.ts --incremental",
    "motorapis:trial": "npm run auctionsapi:trial",
    "motorapis:import": "npm run auctionsapi:import",
    "motorapis:sync": "npm run auctionsapi:sync",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
