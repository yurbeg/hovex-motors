# Public URL of a server-side AI assistant endpoint. Do not put API keys here.
VITE_ASSISTANT_API_URL=

# Public Supabase browser configuration. Never place a secret/service_role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only AuctionsAPI credential. Never rename this to VITE_* or expose it to browser code.
AUCTIONSAPI_API_KEY=
AUCTIONSAPI_BASE_URL=https://auctionsapi.com/api

# Server-only Supabase settings used by the local import commands. Hosted Edge
# Functions receive their project URL and secret keys from Supabase automatically.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional AuctionsAPI Edge Function tuning (safe defaults shown). The /cars
# endpoint defaults to 50 rows; its accepted maximum depends on your plan.
AUCTIONSAPI_TIMEOUT_MS=15000
AUCTIONSAPI_MAX_RETRIES=3
AUCTIONSAPI_PAGE_SIZE=50
AUCTIONSAPI_TRIAL_PAGE_SIZE=5
AUCTIONSAPI_SYNC_OVERLAP_MINUTES=5
AUCTIONSAPI_ARCHIVE_SAFETY_MINUTES=120
AUCTIONSAPI_SYNC_LEASE_SECONDS=900
